# ============================================================
# Lingora — variables de producción (Render / API)
# Copia estos nombres en el panel de Render. No subas valores reales.
# ============================================================

NODE_ENV=production
NODE_VERSION=24.0.0

# Neon: usa la cadena pooled para la API.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Genera uno con: openssl rand -hex 32
JWT_SECRET=

# IA: Anthropic por defecto. Sin clave, el chat responde 503.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Alternativa compatible con OpenAI (OpenRouter, Groq, etc.):
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=anthropic/claude-haiku-4.5
# AI_REASONING=off

# Sin ElevenLabs: la escena usa la voz nativa del navegador.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_A=
# ELEVENLABS_VOICE_B=
# TTS_CACHE_DIR=

# Opcional: emails con acceso a /api/admin/metrics.
ADMIN_EMAILS=
