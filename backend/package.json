{
  "name": "@vox/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/index.ts",
    "start": "node --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:push:test": "DATABASE_URL=postgresql://postgres@127.0.0.1:5432/vox_test drizzle-kit push",
    "backdrops:backfill": "node --env-file-if-exists=.env.local scripts/backfill-backdrops.ts",
    "vocabulary:backfill": "node --env-file-if-exists=.env.local scripts/backfill-vocabulary.ts",
    "content:prewarm": "node --env-file-if-exists=.env.local scripts/prewarm-content.ts",
    "genders:backfill": "node --env-file-if-exists=.env.local scripts/backfill-genders.ts",
    "xp:backfill": "node --env-file-if-exists=.env.local scripts/backfill-xp.ts",
    "missions:generate": "node --env-file-if-exists=.env.local scripts/generate-missions.ts",
    "missions:seed": "node --env-file-if-exists=.env.local scripts/seed-missions.ts",
    "missions:renumber": "node --env-file-if-exists=.env.local scripts/renumber-missions.ts"
  },
  "dependencies": {
    "@vox/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
