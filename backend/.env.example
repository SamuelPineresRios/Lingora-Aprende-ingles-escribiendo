# ============================================================
# Letoura — Backend
# Copia este archivo a .env.local y rellena tus valores:
#   cp .env.example .env.local
# .env.local está en .gitignore. NUNCA subas claves al repositorio.
# ============================================================

# --- Servidor -----------------------------------------------
PORT=4000
NODE_ENV=development

# --- PostgreSQL (Drizzle) -----------------------------------
# Base de datos local:
#   createdb vox
# El esquema se crea con:  npm run db:push -w @vox/backend
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/vox

# --- Sesión -------------------------------------------------
# Firma del JWT de la cookie HttpOnly. Mínimo 32 caracteres aleatorios.
#   openssl rand -hex 32
# Rotarlo invalida todas las sesiones activas.
JWT_SECRET=

# --- IA (Anthropic Claude) ----------------------------------
# Evaluación de escritura y chat del tutor.
# Si está vacía, las rutas de IA responden 503 en vez de fallar.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo de Claude. Si se omite, se usa el snapshot fijado de Haiku 4.5:
#   claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Proveedor alternativo (compatible con OpenAI) ----------
# Con AI_PROVIDER=openai se usa esta API en vez de Anthropic. Sirve para
# OpenRouter, DeepSeek, Groq, Ollama… La clave va SOLO aquí: nunca en el código.
# Comprueba la configuración con: npm run ai:check -w @vox/backend
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=anthropic/claude-haiku-4.5
# Modelos razonadores: `off` apaga el razonamiento, `low|medium|high` lo limita
# (solo OpenRouter). Sin la variable, el proveedor decide.
# AI_REASONING=off

# --- Voz (ElevenLabs) ---------------------------------------
# Voz natural para la escena narrativa. Si está vacía, la escena usa la voz
# nativa del navegador (si la tiene) y las rutas de voz responden 503.
# El audio se cachea en disco: cada frase se sintetiza una sola vez.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voces de los dos personajes (ids de ElevenLabs). Por defecto:
#   A = Sarah (EXAVITQu4vr4xnSDxMaL)  B = Adam (pNInz6obpgDQGcFmaJgB)
# ELEVENLABS_VOICE_A=
# ELEVENLABS_VOICE_B=

# Directorio de la caché de audio. Por defecto backend/.cache/tts
# TTS_CACHE_DIR=

# --- Opcionales ---------------------------------------------
# Emails con acceso a GET /api/admin/metrics (separados por coma).
ADMIN_EMAILS=
